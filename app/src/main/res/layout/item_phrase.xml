<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#D2DCB6"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Languages Row (Headers) -->
        <LinearLayout
            android:id="@+id/layout_languages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/text_source_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="English"
                android:textColor="#4E612C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="12dp"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="@null"
                app:tint="#4E612C" />

            <TextView
                android:id="@+id/text_target_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Cuyonon"
                android:textColor="#4E612C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"/>

        </LinearLayout>

        <!-- Source Phrase -->
        <TextView
            android:id="@+id/text_source_phrase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="2sp"
            android:text="how much"
            android:textColor="#3A3838"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_languages" />

        <!-- Vertical Arrow -->
        <ImageView
            android:id="@+id/icon_arrow_down"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginVertical="8dp"
            android:rotation="90"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_source_phrase"
            app:tint="#4E612C" />

        <!-- Target Phrase -->
        <TextView
            android:id="@+id/text_target_phrase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="2sp"
            android:text="Tag pira"
            android:textColor="#3A3838"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icon_arrow_down" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>