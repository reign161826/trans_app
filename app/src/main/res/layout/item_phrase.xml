<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#D2DCB6"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Languages Row (Headers) -->
        <LinearLayout
            android:id="@+id/layout_languages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/text_source_lang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="English"
                android:textColor="#4E612C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"/>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/text_target_lang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Cuyonon"
                android:textColor="#4E612C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"/>

        </LinearLayout>

        <!-- Phrases Row -->
        <LinearLayout
            android:id="@+id/layout_phrases"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_languages">

            <TextView
                android:id="@+id/text_source_phrase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="2sp"
                android:text="how much"
                android:textColor="#3A3838"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="→"
                android:textColor="#4E612C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_target_phrase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="2sp"
                android:text="Tag pira"
                android:textColor="#3A3838"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_phrases">

            <ImageButton
                android:id="@+id/btn_speak"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_outline"
                android:contentDescription="Speak"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speak"
                app:tint="#4E612C" />

            <ImageButton
                android:id="@+id/btn_copy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_outline"
                android:contentDescription="Copy"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy"
                app:tint="#4E612C" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>