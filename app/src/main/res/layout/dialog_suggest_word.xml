<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#F6F0D7"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header Area (Sage Green) -->
        <View
            android:id="@+id/header_bg"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#9CAB84"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="@string/suggest_to_dictionary"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/header_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/header_bg" />

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/content_description_close"
            app:layout_constraintBottom_toBottomOf="@id/header_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/header_bg"
            app:tint="#FFFFFF" />

        <!-- Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/header_bg">

            <TextView
                android:id="@+id/dialog_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/suggest_subtitle"
                android:textColor="#4E612C"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/label_source_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_language_source"
                android:textColor="#4E612C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_word_to_add"
                android:padding="12dp"
                android:background="@drawable/box_background"
                android:textColor="#3A3838"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:id="@+id/label_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_description_optional"
                android:textColor="#4E612C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edit_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_description_optional"
                android:padding="12dp"
                android:background="@drawable/box_background"
                android:textColor="#3A3838"
                android:gravity="top"
                android:minLines="3"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no"
                android:inputType="textMultiLine" />

            <!-- Translation 1 -->
            <TextView
                android:id="@+id/label_translation_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_translation_optional"
                android:textColor="#4E612C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edit_translation_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_translation_optional"
                android:padding="12dp"
                android:background="@drawable/box_background"
                android:textColor="#3A3838"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <!-- Translation 2 -->
            <TextView
                android:id="@+id/label_translation_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_translation_optional"
                android:textColor="#4E612C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/edit_translation_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_translation_optional"
                android:padding="12dp"
                android:background="@drawable/box_background"
                android:textColor="#3A3838"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_submit_suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/submit_suggestion"
                android:backgroundTint="#4E612C"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>